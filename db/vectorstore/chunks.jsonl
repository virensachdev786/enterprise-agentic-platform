{"id": "password_reset_eligibility_chunk_0", "policy_file": "password_reset_eligibility", "policy_title": "Password Reset Eligibility Policy", "section": "Overview", "text": "# Password Reset Eligibility Policy", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Password Reset Eligibility Policy", "section_name": "Overview", "risk_level": "MEDIUM"}}
{"id": "password_reset_eligibility_chunk_1", "policy_file": "password_reset_eligibility", "policy_title": "Password Reset Eligibility Policy", "section": "Purpose", "text": "Define when automated password reset is allowed.", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Password Reset Eligibility Policy", "section_name": "Purpose", "risk_level": "MEDIUM"}}
{"id": "password_reset_eligibility_chunk_2", "policy_file": "password_reset_eligibility", "policy_title": "Password Reset Eligibility Policy", "section": "Allowed Reset Conditions", "text": "1. Account in \"Locked\" state\n2. Account in \"Active but password expired\"\n3. User identity successfully verified", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Password Reset Eligibility Policy", "section_name": "Allowed Reset Conditions", "risk_level": "MEDIUM"}}
{"id": "password_reset_eligibility_chunk_3", "policy_file": "password_reset_eligibility", "policy_title": "Password Reset Eligibility Policy", "section": "Not Allowed Conditions", "text": "1. User marked as VIP / Executive\n2. Account disabled or terminated\n3. Security risk flagged on account\n4. Policy retrieval fails", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Password Reset Eligibility Policy", "section_name": "Not Allowed Conditions", "risk_level": "MEDIUM"}}
{"id": "password_reset_eligibility_chunk_4", "policy_file": "password_reset_eligibility", "policy_title": "Password Reset Eligibility Policy", "section": "System Behavior", "text": "If NOT eligible:\n- Do not reset\n- Open ServiceNow incident\n- Notify security team if high risk", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Password Reset Eligibility Policy", "section_name": "System Behavior", "risk_level": "MEDIUM"}}
{"id": "failure_escalation_policy_chunk_0", "policy_file": "failure_escalation_policy", "policy_title": "Failed Verification & Risk Escalation Policy", "section": "Overview", "text": "# Failed Verification & Risk Escalation Policy", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Failed Verification & Risk Escalation Policy", "section_name": "Overview", "risk_level": "HIGH"}}
{"id": "failure_escalation_policy_chunk_1", "policy_file": "failure_escalation_policy", "policy_title": "Failed Verification & Risk Escalation Policy", "section": "Purpose", "text": "Mitigate brute-force, phishing, and social engineering attempts.", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Failed Verification & Risk Escalation Policy", "section_name": "Purpose", "risk_level": "HIGH"}}
{"id": "failure_escalation_policy_chunk_2", "policy_file": "failure_escalation_policy", "policy_title": "Failed Verification & Risk Escalation Policy", "section": "Rules", "text": "1. If identity verification fails 2 times \u2192 require MFA verification again\n2. If verification fails 3 times:\n   - Block automated reset\n   - Log security event\n   - Create Incident\n3. If request contains suspicious language:\n   - Treat as high risk\n   - Deny reset\n   - Escalate", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Failed Verification & Risk Escalation Policy", "section_name": "Rules", "risk_level": "HIGH"}}
{"id": "failure_escalation_policy_chunk_3", "policy_file": "failure_escalation_policy", "policy_title": "Failed Verification & Risk Escalation Policy", "section": "High-Risk Indicators", "text": "- Multiple reset attempts in < 10 min\n- User unreachable to confirm\n- Device not trusted", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Failed Verification & Risk Escalation Policy", "section_name": "High-Risk Indicators", "risk_level": "HIGH"}}
{"id": "audit_logging_policy_chunk_0", "policy_file": "audit_logging_policy", "policy_title": "Audit & Compliance Logging Policy", "section": "Overview", "text": "# Audit & Compliance Logging Policy", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Audit & Compliance Logging Policy", "section_name": "Overview", "risk_level": "LOW"}}
{"id": "audit_logging_policy_chunk_1", "policy_file": "audit_logging_policy", "policy_title": "Audit & Compliance Logging Policy", "section": "Purpose", "text": "Ensure compliance & traceability.", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Audit & Compliance Logging Policy", "section_name": "Purpose", "risk_level": "LOW"}}
{"id": "audit_logging_policy_chunk_2", "policy_file": "audit_logging_policy", "policy_title": "Audit & Compliance Logging Policy", "section": "Required Logging", "text": "System must log:\n- User ID\n- Reset initiator (AI Agent / Admin)\n- Timestamp\n- IP / context\n- Verification method used\n- Decision (Approved / Denied)\n- Incident number if created", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Audit & Compliance Logging Policy", "section_name": "Required Logging", "risk_level": "LOW"}}
{"id": "audit_logging_policy_chunk_3", "policy_file": "audit_logging_policy", "policy_title": "Audit & Compliance Logging Policy", "section": "Mandate", "text": "Logs must be retained minimum 12 months.", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Audit & Compliance Logging Policy", "section_name": "Mandate", "risk_level": "LOW"}}
{"id": "incident_policy_chunk_0", "policy_file": "incident_policy", "policy_title": "Password Reset Incident Handling Policy", "section": "Overview", "text": "# Password Reset Incident Handling Policy", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Password Reset Incident Handling Policy", "section_name": "Overview", "risk_level": "MEDIUM"}}
{"id": "incident_policy_chunk_1", "policy_file": "incident_policy", "policy_title": "Password Reset Incident Handling Policy", "section": "Create Incident IF:", "text": "1. VIP account\n2. Identity verification fails\n3. MFA failure\n4. Reset system error\n5. Policy conflict", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Password Reset Incident Handling Policy", "section_name": "Create Incident IF:", "risk_level": "MEDIUM"}}
{"id": "incident_policy_chunk_2", "policy_file": "incident_policy", "policy_title": "Password Reset Incident Handling Policy", "section": "Resolution Rules", "text": "- If reset successful \u2192 Close incident as Solution Provided\n- If user cannot verify \u2192 Escalate to IT Support", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Password Reset Incident Handling Policy", "section_name": "Resolution Rules", "risk_level": "MEDIUM"}}
{"id": "identity_verification_policy_chunk_0", "policy_file": "identity_verification_policy", "policy_title": "Identity Verification Policy", "section": "Overview", "text": "# Identity Verification Policy", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Identity Verification Policy", "section_name": "Overview", "risk_level": "MEDIUM"}}
{"id": "identity_verification_policy_chunk_1", "policy_file": "identity_verification_policy", "policy_title": "Identity Verification Policy", "section": "Purpose", "text": "To ensure password resets are performed securely and only for verified users.", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Identity Verification Policy", "section_name": "Purpose", "risk_level": "MEDIUM"}}
{"id": "identity_verification_policy_chunk_2", "policy_file": "identity_verification_policy", "policy_title": "Identity Verification Policy", "section": "Rules", "text": "1. The system must verify the requesting user\u2019s identity before a password reset is initiated.\n2. Acceptable verification types:\n   - ServiceNow user record validation\n   - Security question verification (if enabled)", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Identity Verification Policy", "section_name": "Rules", "risk_level": "MEDIUM"}}
{"id": "identity_verification_policy_chunk_3", "policy_file": "identity_verification_policy", "policy_title": "Identity Verification Policy", "section": "Special Notes", "text": "- If identity cannot be verified \u2192 Reset MUST NOT proceed.\n- If verification fails 3 times \u2192 Escalate to human support.", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Identity Verification Policy", "section_name": "Special Notes", "risk_level": "MEDIUM"}}
{"id": "remote_network_policy_chunk_0", "policy_file": "remote_network_policy", "policy_title": "Remote vs On-Network Policy", "section": "Overview", "text": "# Remote vs On-Network Policy", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Remote vs On-Network Policy", "section_name": "Overview", "risk_level": "MEDIUM"}}
{"id": "remote_network_policy_chunk_1", "policy_file": "remote_network_policy", "policy_title": "Remote vs On-Network Policy", "section": "Remote User Policy", "text": "- Remote users MUST complete MFA verification.\n- Additional device validation is recommended.\n- Temporary password must be sent via secure channel only.", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Remote vs On-Network Policy", "section_name": "Remote User Policy", "risk_level": "MEDIUM"}}
{"id": "remote_network_policy_chunk_2", "policy_file": "remote_network_policy", "policy_title": "Remote vs On-Network Policy", "section": "On-Network User Policy", "text": "- MFA strongly recommended\n- At minimum, confirm user match & email confirmation", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Remote vs On-Network Policy", "section_name": "On-Network User Policy", "risk_level": "MEDIUM"}}
{"id": "remote_network_policy_chunk_3", "policy_file": "remote_network_policy", "policy_title": "Remote vs On-Network Policy", "section": "Blocking Rules", "text": "If MFA unavailable for Remote users:\n\u2192 Reset NOT allowed\n\u2192 Create support ticket", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "Remote vs On-Network Policy", "section_name": "Blocking Rules", "risk_level": "MEDIUM"}}
{"id": "mfa_policy_chunk_0", "policy_file": "mfa_policy", "policy_title": "MFA Enforcement Policy", "section": "Overview", "text": "# MFA Enforcement Policy", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "MFA Enforcement Policy", "section_name": "Overview", "risk_level": "HIGH"}}
{"id": "mfa_policy_chunk_1", "policy_file": "mfa_policy", "policy_title": "MFA Enforcement Policy", "section": "Rule", "text": "MFA is mandatory for:\n- Remote users\n- VIP users\n- First-time reset attempts\n- Suspicious activity users", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "MFA Enforcement Policy", "section_name": "Rule", "risk_level": "HIGH"}}
{"id": "mfa_policy_chunk_2", "policy_file": "mfa_policy", "policy_title": "MFA Enforcement Policy", "section": "Exception", "text": "If MFA system unavailable \u2192 deny automated reset", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "MFA Enforcement Policy", "section_name": "Exception", "risk_level": "HIGH"}}
{"id": "vip_policy_chunk_0", "policy_file": "vip_policy", "policy_title": "VIP & Executive Password Reset Policy", "section": "Overview", "text": "# VIP & Executive Password Reset Policy", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "VIP & Executive Password Reset Policy", "section_name": "Overview", "risk_level": "HIGH"}}
{"id": "vip_policy_chunk_1", "policy_file": "vip_policy", "policy_title": "VIP & Executive Password Reset Policy", "section": "Purpose", "text": "Ensure additional protection for high-value accounts.", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "VIP & Executive Password Reset Policy", "section_name": "Purpose", "risk_level": "HIGH"}}
{"id": "vip_policy_chunk_2", "policy_file": "vip_policy", "policy_title": "VIP & Executive Password Reset Policy", "section": "VIP Users Include:", "text": "- Executives (VP, C-Level, Directors)\n- System Administrators\n- Finance leadership\n- Security leadership", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "VIP & Executive Password Reset Policy", "section_name": "VIP Users Include:", "risk_level": "HIGH"}}
{"id": "vip_policy_chunk_3", "policy_file": "vip_policy", "policy_title": "VIP & Executive Password Reset Policy", "section": "Rules", "text": "1. Automated password reset is NOT allowed.\n2. MFA must always be required.\n3. Reset must be performed by privileged IT admin only.\n4. Incident must be logged with severity HIGH.", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "VIP & Executive Password Reset Policy", "section_name": "Rules", "risk_level": "HIGH"}}
{"id": "vip_policy_chunk_4", "policy_file": "vip_policy", "policy_title": "VIP & Executive Password Reset Policy", "section": "System Behavior", "text": "If VIP detected:\n- Do NOT auto reset\n- Create HIGH PRIORITY ServiceNow ticket", "metadata": {"type": "policy", "source": "internal_security_policy", "policy_name": "VIP & Executive Password Reset Policy", "section_name": "System Behavior", "risk_level": "HIGH"}}
